<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Koleksi Film</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <nav class="navbar">
        <b>koleksi film</b>
        <div>
            <a href="#tambah">Tambah Film</a>
            <a href="#daftar">Daftar Film</a>
        </div>
    </nav>

    <header class="hero">
        <small>My watchlist, kept simple</small>
        <h1>From the watchlist to the watched list</h1>
        <p>A small notebook for movies. Title, director, a rating, and a few words on how it felt.</p>
        <div class="hero-aksi">
            <a class="tombol" href="#tambah">Add a film</a>
            <span class="jumlah"><%= koleksi.length %> films saved</span>
        </div>
    </header>

    <section class="bagian-form" id="tambah">
        <div class="kotak">
            <h2>Tambah Film</h2>

            <% if (error) { %>
                <div class="peringatan"><%= error %></div>
            <% } %>

            <form method="POST" action="/koleksi">
                <div class="grid-form">
                    <div class="penuh">
                        <label>Judul</label>
                        <input type="text" name="judul" required>
                    </div>
                    <div>
                        <label>Sutradara</label>
                        <input type="text" name="sutradara" required>
                    </div>
                    <div>
                        <label>Tahun Rilis</label>
                        <input type="number" name="tahun" min="1888" max="2100" required>
                    </div>
                    <div>
                        <label>Genre</label>
                        <input type="text" name="genre" required>
                    </div>
                    <div>
                        <label>Status Nonton</label>
                        <select name="status_nonton">
                            <% STATUS.forEach(s => { %>
                                <option value="<%= s %>"><%= s %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="penuh">
                        <label>Rating (0-10, boleh kosong)</label>
                        <input type="number" name="rating" step="0.1" min="0" max="10">
                    </div>
                    <div class="penuh">
                        <label>Review</label>
                        <textarea name="review" required></textarea>
                    </div>
                </div>
                <div class="aksi-form">
                    <button class="tombol" type="submit">Simpan</button>
                </div>
            </form>
        </div>
    </section>

    <section class="daftar" id="daftar">
        <h2>Daftar Film</h2>
        <table>
            <tr>
                <th>No</th>
                <th>Judul</th>
                <th>Sutradara</th>
                <th>Tahun</th>
                <th>Genre</th>
                <th>Status</th>
                <th>Rating</th>
                <th>Review</th>
                <th>Aksi</th>
            </tr>
            <% if (koleksi.length === 0) { %>
            <tr><td class="kosong" colspan="9">Belum ada data film.</td></tr>
            <% } %>
            <% koleksi.forEach((k, i) => { %>
            <tr>
                <td><%= i + 1 %></td>
                <td><%= k.judul %></td>
                <td><%= k.sutradara %></td>
                <td><%= k.tahun %></td>
                <td><%= k.genre %></td>
                <td>
                    <span class="status <%= k.status_nonton === 'Selesai' ? 'selesai' : 'belum' %>">
                        <%= k.status_nonton %>
                    </span>
                </td>
                <td><%= k.rating === null ? '-' : k.rating %></td>
                <td><%= k.review %></td>
                <td class="aksi">
                    <form method="GET" action="/koleksi/<%= k.id %>/edit">
                        <button class="btn-kecil btn-edit" type="submit">Edit</button>
                    </form>
                    <form method="POST" action="/koleksi/<%= k.id %>/delete"
                          onsubmit="return confirm('Yakin hapus film ini?')">
                        <button class="btn-kecil btn-hapus" type="submit">Hapus</button>
                    </form>
                </td>
            </tr>
            <% }) %>
        </table>
    </section>

    <div class="footer">Koleksi Film</div>

</body>
</html>